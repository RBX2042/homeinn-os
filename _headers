  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://evguvdpuidyvkiinzvys.supabase.co wss://evguvdpuidyvkiinzvys.supabase.co; frame-src 'self' https://www.google.com https://maps.google.com https://*.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

